# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Anthropic API key for Claude. Leave blank to run with rules-only categorization
# and an offline assistant.
ANTHROPIC_API_KEY=

# Model name used by ClaudeAdapter. Change this without touching code.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local SQLite database file. Tests use an in-memory database instead.
BUDGET_BUDDY_DB=budgetbuddy.db
