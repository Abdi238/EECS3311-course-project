# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# API key for Claude. Replace the blank value with your own key, or leave it
# blank to run with rules-only categorization and an offline assistant.
LLM_API_KEY=

# Model name used by ClaudeAdapter. Change this without touching code.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local SQLite database file. Tests use an in-memory database instead.
BUDGET_BUDDY_DB=budgetbuddy.db
