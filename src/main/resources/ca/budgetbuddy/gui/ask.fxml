<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ca.budgetbuddy.gui.AskController"
      spacing="8" style="-fx-padding: 12;">
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="questionField" promptText="Ask about the fake ledger" HBox.hgrow="ALWAYS"/>
        <Button text="Send" onAction="#onSend"/>
    </HBox>
    <TextArea fx:id="answerArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
    <Label fx:id="toolsLabel" text="Tools used: none"/>
</VBox>
