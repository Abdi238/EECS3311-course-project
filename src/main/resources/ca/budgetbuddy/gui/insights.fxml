<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ca.budgetbuddy.gui.InsightsController"
      spacing="8" style="-fx-padding: 12;">
    <Label text="Spending trends"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="fromMonth" promptText="From yyyy-MM" prefWidth="140"/>
        <TextField fx:id="toMonth" promptText="To yyyy-MM" prefWidth="140"/>
        <Button text="Show trends" onAction="#onShowTrends"/>
    </HBox>
    <TableView fx:id="trendTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="monthColumn" text="Month" prefWidth="140"/>
            <TableColumn fx:id="incomeColumn" text="Income" prefWidth="140"/>
            <TableColumn fx:id="spentColumn" text="Spent" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
